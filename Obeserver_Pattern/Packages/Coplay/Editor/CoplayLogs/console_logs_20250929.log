    public void TasksExecuting()
    {
        debugTasksTex.text = "Tasks Executing";
        SequenceTasksTesting sequenceTasksTesting = FindObjectOfType<SequenceTasksTesting>();
        StartCoroutine(sequenceTasksTesting.Tasks());
    }
}

